# ============================================================
# TTBYS local configuration template.
# Copy to .env and fill in your values:  cp .env.example .env
# The real .env is gitignored — never commit actual API keys.
# Values here override the defaults in ttbys/config.py.
# ============================================================

# ---- Model paths (optional; can also be set in ttbys/config.py) ----
# LLM used by First/Second/Third Think (desire classification, belief
# generation, strategy prediction).
TTBYS_MODEL_DIR=/path/to/your/llm
# LLM used by agent.py for generating persuasive responses.
# Falls back to TTBYS_MODEL_DIR when empty.
TTBYS_GEN_MODEL_DIR=
# Sentence-embedding model used for experience retrieval.
TTBYS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Evaluation API (used by ttbys/second_think_eval.py) ----
# OpenAI-compatible endpoint for GPT-based belief scoring.
EVAL_API_HOST=https://api.openai.com/v1
EVAL_API_KEY=sk-your-api-key-here
EVAL_MODEL=gpt-4o-mini

# ---- GPU selection (optional; config.py defaults to GPU 4) ----
# CUDA_DEVICE_ORDER=PCI_BUS_ID
# CUDA_VISIBLE_DEVICES=4
